{
  "name": "dsh-route-clone",
  "version": "0.2.0",
  "description": "DSH plugin: copy a provider preset's route configuration into an independently named route group with its own API key.",
  "license": "MIT",
  "author": "kabarryo",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "provider",
    "route",
    "api-key",
    "clone"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kabarryo/dsh-route-clone.git"
  },
  "homepage": "https://github.com/kabarryo/dsh-route-clone#readme",
  "bugs": {
    "url": "https://github.com/kabarryo/dsh-route-clone/issues"
  }
}
